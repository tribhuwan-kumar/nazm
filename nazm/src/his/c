use std::time::Duration;
use tracing::{debug, warn};
use std::collections::HashSet;
use std::collections::HashMap;
use std::sync::{Arc, Mutex, OnceLock};

use crate::{
	AppState,
	his::service::HistoryService,
	aria2::types::{
		UriMetadata, UriCacheState
	}
};

pub const HTTP_CLIENT_TIMEOUT_DURATION: u64 = 20;

static HTTP_CLIENT: OnceLock<reqwest::Client> = OnceLock::new();
static PENDING_PROBES: OnceLock<Arc<Mutex<HashSet<String, UriCacheState>>>> = OnceLock::new();

static URI_CACHE: OnceLock<Arc<Mutex<HashMap<String, UriCacheState>>>> = OnceLock::new();

pub fn uri_cache() -> &'static Arc<Mutex<HashMap<String, UriCacheState>>> {
    URI_CACHE.get_or_init(|| Arc::new(Mutex::new(HashMap::new())))
}

pub fn pending_probes() -> &'static Arc<Mutex<HashSet<String, UriCacheState>>> {
    PENDING_PROBES.get_or_init(|| Arc::new(Mutex::new(HashSet::new())))
}

pub fn http_client() -> &'static Client {
    HTTP_CLIENT.get_or_init(|| {
        Client::builder()
            .timeout(Duration::from_secs(HTTP_CLIENT_TIMEOUT_DURATION))
            .build()
            .unwrap_or_default()
    })
}

pub fn spawn_uri_probe(state: AppState, gid: String, uri: String) {
    // Prevent concurrent probes for the same GID
    if let Ok(mut pending) = pending_probes().lock() {
        if !pending.insert(gid.clone()) {
            return;											// Already actively probing this gid, skip.
        }
        pending.insert(uri.clone(), UriCacheState::Pending);
    }

    tokio::spawn(async move {
        // RAII Guard: Checks the gid is removed from memory when the task exits,
        // Even if the task panics or fails unexpectedly.
        struct ProbeCleanup { gid: String }

        impl Drop for ProbeCleanup {
            fn drop(&mut self) {
                if let Ok(mut pending) = pending_probes().lock() {
                    pending.remove(&self.gid);
                }
            }
        }

        let _cleanup = ProbeCleanup { gid: gid.clone() };

        // Query db: skip if a valid name already exists
        if let Ok(Some(row)) = sqlx::query!("SELECT name FROM download_history WHERE gid = ?", gid)
            .fetch_optional(&state.db).await
        {
            if let Some(name) = row.name {
                if !name.is_empty()
                    && name != "<Untitled>"
                    && name != "Fetching file name..."
                    && name != "Waiting for network..."
                {
					// A valid name is already recorded. don't need to probe!!
                    return;
                }
            }
        }

        let client = http_client().clone();

        // Infinite internet connectivity check
        loop {
            match client.get("http://clients3.google.com/generate_204").send().await {
                Ok(res) if res.status() == 204 => {
                    break;											// Internet is connected, proceed to actual URI probe
                }
                _ => {
                    debug!("No internet connection. waiting for network for GID: {}", gid);
                    let _ = sqlx::query!(
                        "UPDATE download_history SET name = 'Waiting for network...' WHERE gid = ?",
                        gid
                    ).execute(&state.db).await;

                    tokio::time::sleep(Duration::from_secs(7)).await;
                }
            }
        }

        // Internet restored. Update UI.
        let _ = sqlx::query!(
            "UPDATE download_history SET name = 'Fetching file name...' WHERE gid = ?",
            gid
        ).execute(&state.db).await;

        // Actual Target URI Probe
        let mut resumable = false;
        let mut filename = None;
        let mut success = false;
        let max_retries = 3;

        for attempt in 1..=max_retries {
            let mut head_success = false;
            match client.head(&uri).send().await {
                Ok(res) => {
                    head_success = true;
                    if let Some(val) = res.headers().get(reqwest::header::ACCEPT_RANGES) {
                        resumable = val.to_str().map(|v| v.eq_ignore_ascii_case("bytes")).unwrap_or(false);
                    }
                    if let Some(val) = res.headers().get(reqwest::header::CONTENT_DISPOSITION) {
                        if let Ok(s) = val.to_str() {
                            filename = extract_filename(s);
                        }
                    }
                }
                Err(e) => {
                    debug!("HEAD request failed for {:?}: {}. Falling back to GET...", uri, e);
                }
            }

            // If HEAD failed completely, OR if it succeeded but didn't give the headers
            if !head_success || !resumable || filename.is_none() {
                match client.get(&uri).header(reqwest::header::RANGE, "bytes=0-0").send().await {
                    Ok(res_get) => {
                        if !resumable {
                            resumable = res_get.status() == reqwest::StatusCode::PARTIAL_CONTENT;
                        }
                        if filename.is_none() {
                            if let Some(val) = res_get.headers().get(reqwest::header::CONTENT_DISPOSITION) {
                                if let Ok(s) = val.to_str() {
                                    filename = extract_filename(s);
                                }
                            }
                        }
                        success = true;						// GET succeeded
                    }
                    Err(e) => {
                        debug!("GET probe failed for {:?} (Attempt {}/{}): {}", uri, attempt, max_retries, e);
                    }
                }
            } else {
                success = true;
            }

            if success {
                break;
            } else if attempt < max_retries {
                tokio::time::sleep(Duration::from_secs(5)).await;
            }
        }

        if success {
            let final_name = filename.unwrap_or_else(|| {
                // Server responded but gave no name.
				// Fallback to parsing the URL.
                url::Url::parse(&uri)
                    .ok()
                    .and_then(|u| u.path_segments().and_then(|seg| seg.last().map(|s| s.to_string())))
                    .unwrap_or_else(|| "<Untitled>".to_string())
            });

            let final_name = urlencoding::decode(&final_name)
                .map(|d| d.into_owned())
                .unwrap_or(final_name);

            // Persist the permanently resolved name to the db
            let _ = sqlx::query!(
                "UPDATE download_history SET name = ?, is_resume_supported = ? WHERE gid = ?",
                final_name, resumable, gid
            ).execute(&state.db).await;

			HistoryService::handle_event(&state, gid.clone(), None).await;

        } else {
            // On internet, but the target server failed to respond.
            let err_msg = format!("URI server resolution failed or server is down");
            warn!("Failing GID {}: {}", gid, err_msg);

            let _ = sqlx::query!(
                "UPDATE download_history
                    SET status = 'error',
						error_code = 1,
						error_message = ?
                WHERE gid = ?",
                err_msg, gid
            ).execute(&state.db).await;

			HistoryService::handle_event(&state, gid.clone(), None).await;
        }
    });
}

fn extract_filename(header_val: &str) -> Option<String> {
    if let Some(idx) = header_val.find("filename=\"") {
        let start = idx + 10;
        if let Some(end) = header_val[start..].find('"') {
            return Some(header_val[start..start+end].to_string());
        }
    }
    if let Some(idx) = header_val.find("filename=") {
        let start = idx + 9;
        let end = header_val[start..].find(';').unwrap_or(header_val[start..].len());
        let clean = header_val[start..start+end].trim_matches(|c| c == '"' || c == '\'');
        return Some(clean.to_string());
    }
    None
}
